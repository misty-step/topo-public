#!/usr/bin/env bash
# verify-topo: drive Topo the way its users do and keep the evidence.
# Usage: .agents/skills/verify-topo/verify-topo <command> [options]
#   setup                      install locked JS deps and Playwright Chromium
#   doctor [--live]            read-only health; --live adds Access/owner/private checks
#   cli [--source]             install from the public site (or build this checkout), collect, query, render, state
#   browse                     drive the exported map and a composed home from disk
#   site [BASE_URL]            drive the public site (default https://topo.mistystep.io)
#   sign-in [--headed] [--password-env NAME]   owner session on the private maps host
#   all [--source] [--live] [--headed] [--password-env NAME]   doctor, cli, browse, site, then sign-in
#   cleanup [--profile]        remove run scratch; evidence stays; --profile also drops the owner browser profile
# Environment:
#   TOPO_VERIFY_RUN        run directory (default ~/.cache/tmp/verify-topo/default); use one per concurrent run.
#                          It must be new, empty, or an earlier verify-topo run (marked by .verify-topo-run).
#   TOPO_VERIFY_PUBLIC     public site (default https://topo.mistystep.io)
#   TOPO_VERIFY_PRIVATE_SETTINGS  operator's private deployment settings JSON (docs/deployment.md); enables private checks
#   TOPO_VERIFY_OWNER_EMAIL the private deployment's owner identity; required for private checks and sign-in
#   TOPO_VERIFY_OWNER_IDP  name of the only login method the private host may allow (unset: list them, require one)
#   TOPO_VERIFY_OWNER_IDP_TYPE  identity-provider type the owner session must use, e.g. oidc or onetimepin (optional)
#   TOPO_VERIFY_ALLOWED_EMAILS  comma-separated exact set the allow policy must admit; each entry is an address or the
#                          sha256 of its lowercase form (default: the owner only)
#   TOPO_VERIFY_OWNER_PROFILE  owner browser profile (default ~/.cache/tmp/verify-topo/owner-profile)
#   CLOUDFLARE_API_TOKEN, TOPO_MAPS_ACCESS_CREDENTIAL  only for doctor --live (inject from your secret manager)
set -uo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd "$here/../../.." && pwd)
# sha256 of an address's lowercase form; portable to macOS (shasum) and bash 3.2.
digest() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-64; }
resolve() { python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$1"; }
runs_root=$(resolve "$HOME/.cache/tmp/verify-topo")
# Resolved, so a symlinked run directory is cleaned through its target.
run=$(resolve "${TOPO_VERIFY_RUN:-$runs_root/default}")
evidence=$run/evidence
public=${TOPO_VERIFY_PUBLIC:-https://topo.mistystep.io}
settings=${TOPO_VERIFY_PRIVATE_SETTINGS:-}
private='' account='' team='' audience=''
if [[ -n $settings ]]; then
  [[ -r $settings ]] || { printf 'FAIL TOPO_VERIFY_PRIVATE_SETTINGS is not readable: %s\n' "$settings"; exit 64; }
  private=$(jq -r '.vars.PRIVATE_HOST // empty' "$settings")
  [[ -n $private ]] || { printf 'FAIL TOPO_VERIFY_PRIVATE_SETTINGS is not settings JSON with vars.PRIVATE_HOST: %s\n' "$settings"; exit 64; }
  private=https://$private
  account=$(jq -r '.account_id // empty' "$settings")
  team=$(jq -r '.vars.ACCESS_TEAM_DOMAIN // empty' "$settings")
  audience=$(jq -r '.vars.ACCESS_AUD // empty' "$settings")
  [[ $team == https://*.cloudflareaccess.com ]] || { printf 'FAIL TOPO_VERIFY_PRIVATE_SETTINGS vars.ACCESS_TEAM_DOMAIN is not https://<team>.cloudflareaccess.com: %s\n' "$settings"; exit 64; }
fi
owner=${TOPO_VERIFY_OWNER_EMAIL:-}
owner_idp=${TOPO_VERIFY_OWNER_IDP:-}
allowed_emails=${TOPO_VERIFY_ALLOWED_EMAILS:-$owner}
profile=$(resolve "${TOPO_VERIFY_OWNER_PROFILE:-$runs_root/owner-profile}")
export TOPO_VERIFY_OWNER_PROFILE=$profile
export TOPO_VERIFY_REPO=$repo TOPO_VERIFY_OWNER_EMAIL=$owner TOPO_VERIFY_ACCESS_TEAM=$team
failures=0

say() { printf '%s\n' "$*"; }
pass() { say "PASS $*"; }
fail() { say "FAIL $*"; failures=$((failures + 1)); }
skip() { say "SKIP $*"; }
browser() { (cd "$repo" && node "$here/browser.mjs" "$@"); }
# Credentials go to curl as header files, never as command-line arguments.
cf_get() { curl -fsS -H @<(printf 'Authorization: Bearer %s\n' "$CLOUDFLARE_API_TOKEN") "https://api.cloudflare.com/client/v4/accounts/$account/$1"; }

# Refuse to treat an arbitrary directory as a run: cleanup deletes everything in it except evidence/.
guard_run() {
  local repo_real; repo_real=$(resolve "$repo")
  case $run in
    /|"$(resolve "$HOME")"|"$runs_root"|"$repo_real"|"$repo_real"/*) say "FAIL refusing TOPO_VERIFY_RUN=$run: not a scratch run directory"; exit 64 ;;
  esac
  [[ $repo_real/ == "$run"/* ]] && { say "FAIL refusing TOPO_VERIFY_RUN=$run: it contains this checkout"; exit 64; }
  [[ $profile == "$run" || $profile/ == "$run"/* ]] && { say "FAIL refusing TOPO_VERIFY_RUN=$run: it contains the owner profile"; exit 64; }
  return 0
}
claim_run() {
  guard_run
  if [[ -d $run && ! -e $run/.verify-topo-run && -n $(ls -A "$run") ]]; then
    say "FAIL refusing TOPO_VERIFY_RUN=$run: non-empty and not a verify-topo run (no .verify-topo-run)"; exit 64
  fi
  mkdir -p "$run/evidence" && : > "$run/.verify-topo-run"
}

cmd_setup() {
  (cd "$repo" && bun install --frozen-lockfile && bunx --no-install playwright install chromium)
}

cmd_doctor() {
  local live=false; [[ ${1:-} == --live ]] && live=true
  for tool in git curl jq node bun cargo python3; do
    command -v "$tool" >/dev/null && pass "tool $tool" || fail "tool $tool missing"
  done
  [[ -d $repo/node_modules/playwright ]] && pass "playwright installed in $repo" || fail "playwright missing: run verify-topo setup"
  say "INFO checkout $(git -C "$repo" rev-parse HEAD) on $(git -C "$repo" branch --show-current)"
  local health manifest
  health=$(curl -fsS "$public/health") && manifest=$(curl -fsS "$public/manifest.json") || { fail "public site unreachable: $public"; health='{}'; manifest='{}'; }
  local hs ms
  hs=$(jq -r .source <<<"$health"); ms=$(jq -r .source_revision <<<"$manifest")
  [[ $(jq -r .status <<<"$health") == ok && $hs == "$ms" ]] && pass "public /health ok, source $hs, native $(jq -r .native_version <<<"$manifest")" || fail "public /health ($hs) disagrees with manifest ($ms)"
  if git -C "$repo" merge-base --is-ancestor "$hs" HEAD 2>/dev/null; then pass "deployed source $hs is in this checkout's history"
  else say "INFO deployed source $hs is not in this checkout's history (unmerged change, newer deploy, or a deployment built from another repository)"; fi
  if [[ -z $private ]]; then skip "private deployment (n/a: set TOPO_VERIFY_PRIVATE_SETTINGS to your settings JSON)"; return; fi
  local loc
  loc=$(curl -s -o /dev/null -w '%{redirect_url}' "$private/")
  [[ -n $team && $loc == "$team"/cdn-cgi/access/login/* ]] && pass "private host sends anonymous visitors to its Access team" || fail "private host did not redirect to ACCESS_TEAM_DOMAIN: ${loc:-no redirect}"
  if ! $live; then skip "owner identity and private bundle (run: doctor --live with credentials injected)"; return; fi
  [[ -n $owner ]] || fail "TOPO_VERIFY_OWNER_EMAIL not set"
  if [[ -z ${CLOUDFLARE_API_TOKEN:-} ]]; then fail "CLOUDFLARE_API_TOKEN not injected"; else
    local apps app idps
    apps=$(cf_get 'access/apps?per_page=100') || apps='{}'
    app=$(jq -c --arg d "${private#https://}" '[.result[]? | select(.domain == $d)][0] // {}' <<<"$apps")
    [[ -n $audience && $(jq -r '.aud // empty' <<<"$app") == "$audience" ]] \
      && pass "Access app audience matches ACCESS_AUD in the settings" || fail "Access app for ${private#https://} missing or audience differs from ACCESS_AUD"
    # Exactly who may get in: allow rules are exact emails equal to the expected set (compared as sha256 digests),
    # with no require/exclude that could lock the owner out; non-identity rules are service tokens only; no bypass.
    local rules expected actual
    rules=$(jq -c '{allow: [.policies[]? | select(.decision == "allow") | .include[]?],
      conditions: [.policies[]? | select(.decision == "allow") | (.require // []) + (.exclude // []) | .[]],
      other: [.policies[]? | select(.decision == "non_identity") | .include[]? | select(has("service_token") | not)],
      bypass: [.policies[]? | select(.decision == "bypass")]}' <<<"$app")
    expected=$(tr ',' '\n' <<<"$allowed_emails" | while read -r e; do [[ -z $e ]] && continue
      if [[ $e =~ ^[0-9a-f]{64}$ ]]; then echo "$e"; else digest "$e"; fi; done | sort -u)
    actual=$(jq -r '.allow[] | .email.email // "NOT-AN-EMAIL-RULE"' <<<"$rules" | while read -r e; do digest "$e"; done | sort -u)
    if [[ -n $expected && $actual == "$expected" ]] && jq -e 'all(.allow[]; has("email")) and (.conditions | length) == 0 and (.other | length) == 0 and (.bypass | length) == 0' <<<"$rules" >/dev/null; then
      pass "Access admits exactly the $(wc -l <<<"$expected") expected email addresses (owner $owner), no require/exclude, plus service tokens only"
    else fail "Access policy is not exactly the expected addresses: $(jq -c --argjson want "$(wc -l <<<"$expected")" '{allow_rules: [.allow[] | keys[0]], allow_count: (.allow | length), expected_count: $want, require_or_exclude: (.conditions | length), non_token_rules: (.other | length), bypass: (.bypass | length)}' <<<"$rules"), set match: $([[ $actual == "$expected" ]] && echo yes || echo no), owner admitted: $(grep -qx "$(digest "$owner")" <<<"$actual" && echo yes || echo no)"; fi
    idps=$(cf_get access/identity_providers) || idps='{}'
    local allowed
    allowed=$(jq -r --argjson ids "$(jq -c '.allowed_idps // []' <<<"$app")" '[.result[]? | select(.id as $i | $ids | index($i)) | "\(.name) (\(.type))"] | join(", ")' <<<"$idps")
    if [[ -z $allowed || $allowed == *", "* ]]; then fail "login methods are not exactly one: ${allowed:-none (empty allowed_idps admits every method)}"
    elif [[ -n $owner_idp && $allowed != "$owner_idp ("* ]]; then fail "only login method is $allowed, expected $owner_idp"
    else pass "only login method: $allowed"; fi
    local last
    last=$(cf_get "access/logs/access_requests?limit=1000&direction=desc&email=$owner" \
      | jq -r --arg d "${private#https://}" '[.result[]? | select(.app_domain == $d)][0] | if . then "\(.created_at) allowed=\(.allowed) via \(.connection)" else "none among the most recent owner entries returned (up to 50)" end')
    say "INFO last owner login to ${private#https://}: $last (passive signal only; not agent proof)"
  fi
  if [[ -z ${TOPO_MAPS_ACCESS_CREDENTIAL:-} ]]; then fail "TOPO_MAPS_ACCESS_CREDENTIAL not injected"; else
    local id secret body
    id=$(jq -r .client_id <<<"$TOPO_MAPS_ACCESS_CREDENTIAL"); secret=$(jq -r .client_secret <<<"$TOPO_MAPS_ACCESS_CREDENTIAL")
    body=$(curl -fsS -H @<(printf 'CF-Access-Client-Id: %s\nCF-Access-Client-Secret: %s\n' "$id" "$secret") "$private/manifest.json") || body='{}'
    [[ $(jq -r .schema <<<"$body") == topo.home.v1 ]] \
      && pass "private bundle serves to the publishing service token: generated $(jq -r .generated_at <<<"$body"), source $(jq -r .source_revision <<<"$body") (not owner proof)" \
      || fail "private manifest unreadable with the publishing service token"
  fi
}

fixture() {
  local f=$run/fixture
  rm -rf "$f"; mkdir -p "$f/web/src" "$f/api/src"
  printf '{"name":"beacon-web","version":"1.0.0","dependencies":{"react":"19.0.0"}}\n' > "$f/web/package.json"
  printf 'import { fetchOrders } from "./client";\nimport React from "react";\n// import { ghost } from "./ghost";\nexport const App = () => fetchOrders();\n' > "$f/web/src/app.ts"
  printf 'export function fetchOrders() { return fetch("/api/orders"); }\n' > "$f/web/src/client.ts"
  printf '[package]\nname = "beacon-api"\nversion = "0.1.0"\nedition = "2021"\n[dependencies]\nserde = "1"\n' > "$f/api/Cargo.toml"
  printf 'mod orders;\nuse serde::Serialize;\nfn main() { orders::list(); }\n' > "$f/api/src/main.rs"
  printf 'pub fn list() {}\n' > "$f/api/src/orders.rs"
  printf 'API_KEY=fixture-not-a-secret\n' > "$f/.env"
  printf '.env\n' > "$f/.gitignore"
  git -C "$f" init -q -b main
  git -C "$f" add -A
  git -C "$f" -c user.name=Fixture -c user.email=fixture@example.test commit -qm 'fictional beacon fixture'
  rm -rf "${run:?}/empty-repo" "$run/not-a-repo" "${run:?}"/out-*
  mkdir -p "$run/empty-repo" "$run/not-a-repo" && git -C "$run/empty-repo" init -q -b main
}

# step NAME EXIT PATTERN -- command...: runs from the run directory and records command, exit, stdout and
# stderr in the transcript. Passes only on exactly EXIT with PATTERN (grep -E; '' for none) in stdout+stderr.
# Topo and the installer refuse with exit 1, so a crash (101), signal or missing binary (127) never counts.
step() {
  local name=$1 expect=$2 pattern=$3; shift 4
  local out=$evidence/cli/$name
  (cd "$run" && "$@" > "$out.stdout" 2> "$out.stderr"); local code=$?
  { printf '$ %s\n' "$*"; printf 'exit %s\n' "$code"; sed 's/^/stdout: /' "$out.stdout" | head -12; sed 's/^/stderr: /' "$out.stderr"; echo; } >> "$evidence/cli/transcript.txt"
  local said=true
  [[ -z $pattern ]] || cat "$out.stdout" "$out.stderr" | grep -Eq -- "$pattern" || said=false
  if [[ $code == "$expect" ]] && $said; then
    [[ $expect == 0 ]] && pass "cli $name" || pass "cli $name refused (exit $code): $(head -c 120 "$out.stderr")"
  else fail "cli $name: expected exit $expect${pattern:+ with /$pattern/}, got exit $code: $(head -c 200 "$out.stderr")"; fi
  return 0
}

cmd_cli() {
  mkdir -p "$evidence/cli"; : > "$evidence/cli/transcript.txt"
  local topo
  if [[ ${1:-} == --source ]]; then
    (cd "$repo" && cargo build --locked -j 2 --bin topo --bin topo-home) || { fail "cargo build"; return; }
    topo=$repo/target/debug/topo
    say "INFO driving the source build of this checkout"
  else
    rm -rf "${run:?}/bin"; mkdir -p "$run/bin"
    curl -fsSL "$public/install.sh" -o "$run/install-topo.sh" || { fail "download install.sh"; return; }
    step install 0 '^Installed ' -- env TOPO_INSTALL_DIR="$run/bin" sh "$run/install-topo.sh"
    step install-again-refused 1 '^Already exists: ' -- env TOPO_INSTALL_DIR="$run/bin" sh "$run/install-topo.sh"
    topo=$run/bin/topo
  fi
  fixture
  rm -rf "${run:?}/map" "$run/rendered" "$run/state-out"
  step version 0 '^topo [0-9]+\.[0-9]+\.[0-9]+ ' -- "$topo" --version
  # The namespace matches the fictional project's name, so the composed home links project -> map.
  step run 0 '"coverage": "partial"' -- "$topo" run --repo example/beacon="$run/fixture" --out "$run/map"
  [[ -f $run/map/index.html && -f $run/map/graph.json && -f $run/map/manifest.json ]] && pass "cli run wrote index.html, graph.json, manifest.json" || fail "cli run output files missing"
  jq -e '.entities | has("package:npm:react") and has("package:rust:serde")' "$run/map/graph.json" >/dev/null && pass "cli run found the react and serde declarations" || fail "cli run missed package:npm:react or package:rust:serde"
  if [[ -f $run/map/graph.json && -f $run/map/index.html ]]; then
    grep -q 'ghost' "$run/map/graph.json" && fail "commented import created an entity" || pass "cli commented import ignored"
    grep -q 'fixture-not-a-secret' "$run/map/graph.json" "$run/map/index.html" && fail "ignored .env content leaked into the map" || pass "cli ignored .env stays out of the map"
  else fail "cli import and .env checks need map/graph.json and map/index.html"; fi
  step scopes 0 '' -- "$topo" scopes --graph "$run/map/graph.json"
  jq -e 'has("repo:example/beacon") and has("module:example/beacon:web/src")' "$evidence/cli/scopes.stdout" >/dev/null && pass "cli scopes lists repo and module scopes" || fail "cli scopes missing expected IDs"
  step query-entity 0 '' -- "$topo" query --graph "$run/map/graph.json" --entity file:example/beacon:web/src/app.ts --direction dependencies
  jq -e '[.relationships[].to] | index("file:example/beacon:web/src/client.ts")' "$evidence/cli/query-entity.stdout" >/dev/null && pass "cli query returns app.ts -> client.ts" || fail "cli query missing app.ts -> client.ts"
  local rev; rev=$(jq -r .revision "$run/map/manifest.json")
  step query-revision 0 '' -- "$topo" query --graph "$run/map/graph.json" --scope repo:example/beacon --revision "$rev"
  step render 0 '' -- "$topo" render --graph "$run/map/graph.json" --out "$run/rendered"
  [[ $(jq -r .revision "$run/rendered/manifest.json") == "$rev" ]] && pass "cli render keeps revision $rev" || fail "cli render changed the revision"
  cat > "$run/state.json" <<'JSON'
{"schema":"topo.project-state.v1","collected_at":"2026-10-20T00:00:00Z","inventory_basis":"Fictional verify-topo inventory","option_basis":"Fictional hosting option; not current placement","coverage":"One fictional repository created by verify-topo","gaps":["Fictional fixture; no provider survey"],
"projects":[{"name":"example/beacon","purpose":"Fictional order service used by verify-topo","purpose_source":"fixture","activity":{"date":"2026-10-20","commit":null,"subject":"fictional beacon fixture","source":"fixture git log"},"runtime":[{"status":"unknown","home":"No confirmed deployment","date":"2026-10-20","source":"Fictional fixture"}],"call":"maintain","reason":"Fixture only"}]}
JSON
  step state 0 '' -- "$topo" state --input "$run/state.json" --out "$run/state-out"
  # States that break: each must fail loudly, never return an empty success.
  [[ -f $run/state-out/projects.md && -f $run/state-out/projects.json ]] && pass "cli state wrote projects.md and projects.json" || fail "cli state outputs missing"
  step existing-output 1 'Output already exists' -- "$topo" run --repo example/beacon="$run/fixture" --out "$run/map"
  step unknown-scope 1 'Unknown scope' -- "$topo" query --graph "$run/map/graph.json" --scope module:example/beacon:nope
  step wrong-revision 1 'Graph revision mismatch' -- "$topo" query --graph "$run/map/graph.json" --revision 0000
  step not-a-repo 1 'Git rev-parse failed' -- "$topo" run --repo x="$run/not-a-repo" --out "$run/out-not-a-repo"
  step empty-repo 1 'Git rev-parse failed' -- "$topo" run --repo x="$run/empty-repo" --out "$run/out-empty-repo"
  step bad-namespace 1 'Invalid caller namespace' -- "$topo" run --repo ../x="$run/fixture" --out "$run/out-bad-namespace"
  jq '.entities["package:npm:react"].label = "preact"' "$run/map/graph.json" > "$run/tampered.json"
  step tampered-graph 1 'does not match its content' -- "$topo" query --graph "$run/tampered.json"
  printf '%s\n' "$topo" > "$run/topo-path"
}

cmd_browse() {
  [[ -f $run/map/index.html ]] || { fail "no exported map: run verify-topo cli first"; return; }
  browser map "$run/map/index.html" "$evidence/browse" || fail "map drive (see $evidence/browse/result.json)"
  # Always rebuild (incremental) so the home comes from this checkout, never a stale binary.
  (cd "$repo" && cargo build --locked -j 2 --bin topo-home) > "$evidence/browse/topo-home-build.log" 2>&1 || { fail "build topo-home (see $evidence/browse/topo-home-build.log)"; return; }
  rm -rf "${run:?}/home"
  "$repo/target/debug/topo-home" --state "$run/state-out" --maps "$run/map" --out "$run/home" --stale-after-hours 48 > "$evidence/browse/topo-home.stdout" 2>&1 \
    && grep -q '^Private catalogue composed' "$evidence/browse/topo-home.stdout" \
    && pass "topo-home composed a fictional home: $(head -c 120 "$evidence/browse/topo-home.stdout")" || { fail "topo-home: $(cat "$evidence/browse/topo-home.stdout")"; return; }
  browser home "$run/home/index.html" "$evidence/browse-home" || fail "home drive (see $evidence/browse-home/result.json)"
}

cmd_site() {
  browser site "${1:-$public}" "$evidence/site" || fail "site drive (see $evidence/site/result.json)"
}

cmd_sign_in() {
  if [[ -z $private || -z $owner ]]; then skip "sign-in (n/a: set TOPO_VERIFY_PRIVATE_SETTINGS and TOPO_VERIFY_OWNER_EMAIL)"; return; fi
  # Private-deployment proof names the operator's host and owner: keep it out of evidence/, which may be committed here.
  local private_evidence=$run/private-evidence/sign-in
  browser gate "$private/" "$private_evidence" || fail "signed-out gate (see $private_evidence/result.json)"
  browser owner "$private/" "$private_evidence/owner" "$@"; local code=$?
  if [[ $code == 2 ]]; then say "UNPROVEN owner sign-in: $(jq -r .unproven "$private_evidence/owner/result.json")"; failures=$((failures + 1))
  elif [[ $code != 0 ]]; then fail "owner sign-in (see $private_evidence/owner/result.json)"; fi
}

cmd_cleanup() {
  guard_run
  [[ -e $run/.verify-topo-run ]] || { say "nothing to clean at $run (no .verify-topo-run marker)"; return; }
  find "$run" -mindepth 1 -maxdepth 1 ! -name evidence ! -name .verify-topo-run -exec rm -rf {} +
  if [[ ${1:-} == --profile && -d $profile ]]; then
    # Only a browser profile directory: under the runs root or named *profile*, never home, root, repo or runs root.
    case $profile in
      /|"$(resolve "$HOME")"|"$runs_root"|"$(resolve "$repo")"*) say "FAIL refusing to remove owner profile $profile"; exit 64 ;;
    esac
    if [[ $profile == "$runs_root"/* || $(basename "$profile") == *profile* ]]; then rm -rf "$profile"; say "removed owner profile $profile"
    else say "FAIL refusing to remove $profile: not under $runs_root and not named *profile*"; exit 64; fi
  fi
  say "cleaned $run; evidence kept at $evidence"
}

command=${1:-}; shift || true
case $command in setup|doctor|cli|browse|site|sign-in|all) claim_run ;; esac
case $command in
  setup) cmd_setup ;;
  doctor) cmd_doctor "$@" ;;
  cli) cmd_cli "$@" ;;
  browse) cmd_browse ;;
  site) cmd_site "$@" ;;
  sign-in) cmd_sign_in "$@" ;;
  all)
    doctor_args=() cli_args=() sign_in_args=()
    while (($#)); do
      case $1 in
        --live) doctor_args+=(--live) ;;
        --source) cli_args+=(--source) ;;
        --headed) sign_in_args+=(--headed) ;;
        --password-env) sign_in_args+=(--password-env "${2:?--password-env needs a variable name}"); shift ;;
        *) say "unknown option for all: $1"; exit 64 ;;
      esac; shift
    done
    # ${a[@]+"${a[@]}"} keeps empty arrays safe under set -u on bash 3.2 (macOS).
    cmd_doctor ${doctor_args[@]+"${doctor_args[@]}"}; cmd_cli ${cli_args[@]+"${cli_args[@]}"}; cmd_browse; cmd_site
    cmd_sign_in ${sign_in_args[@]+"${sign_in_args[@]}"} ;;
  cleanup) cmd_cleanup "$@" ;;
  *) sed -n '2,/^set -uo/p' "$0" | sed '$d'; exit 64 ;;
esac
say "evidence: $evidence"
[[ $failures == 0 ]] || { say "$failures check(s) did not pass"; exit 1; }
